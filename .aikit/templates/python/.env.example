# Application
APP_DEBUG=false
APP_ENV=development
APP_PORT=8000

# Database
APP_DATABASE_URL=postgresql://user:pass@localhost:5432/myapp

# Docker Compose database service (docker/compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=myapp
POSTGRES_PORT=5432

# Redis (optional)
# APP_REDIS_URL=redis://localhost:6379

# Security
APP_SECRET_KEY=change-me-in-production

# CORS
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
